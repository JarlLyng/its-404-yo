xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated by XcodeGen — regenerate with `make generate` (or `xcodegen generate`)
*.xcodeproj/

# Swift Package Manager
.build/
.build-spm/
.swiftpm/
Package.resolved

